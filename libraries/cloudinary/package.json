{
  "name": "@dossierhq/cloudinary",
  "version": "0.8.0",
  "description": "A field editor Dossier for Cloudinary images.",
  "keywords": [
    "dossier",
    "cms",
    "cloudinary"
  ],
  "homepage": "https://dossierhq.dev",
  "author": {
    "name": "Jonas Bengtsson"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./lib/index.js",
    "./main.css": "./lib/main.css"
  },
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && postcss src/main.css -o lib/main.css",
    "build:watch": "tsc --watch",
    "lint": "eslint --max-warnings=0",
    "clean": "rm -rf lib/",
    "eslint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dossierhq/dossierhq.git",
    "directory": "libraries/cloudinary"
  },
  "dependencies": {
    "@cloudinary/url-gen": "~1.22.0",
    "lucide-react": "~1.8.0"
  },
  "peerDependencies": {
    "@dossierhq/core": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@dossierhq/core": "workspace:*",
    "@dossierhq/eslint-config": "workspace:*",
    "@dossierhq/react-components2": "workspace:*",
    "@dossierhq/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "~4.3.0",
    "@types/react": "19.2.17",
    "eslint": "~10.8.0",
    "postcss": "~8.5.6",
    "postcss-cli": "~11.0.1",
    "react": "~19.2.7",
    "tailwindcss": "~4.3.0",
    "typescript": "~6.0.3"
  }
}
