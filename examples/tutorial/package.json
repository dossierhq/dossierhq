{
  "name": "dossier-tutorial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -n be,fe --handle-input 'nodemon --watch \"backend/*\" --exec node backend/main.ts' 'sleep 2 && vite'",
    "dev": "vite",
    "build": "./generate-typescript.ts && tsc && vite build",
    "preview": "vite preview",
    "backend": "node backend/main.ts",
    "prettier:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth0/auth0-react": "~2.30.0",
    "@dossierhq/better-sqlite3": "workspace:*",
    "@dossierhq/cloudinary": "workspace:*",
    "@dossierhq/core": "workspace:*",
    "@dossierhq/react-components2": "workspace:*",
    "@dossierhq/server": "workspace:*",
    "better-sqlite3": "~12.9.0",
    "body-parser": "~2.4.0",
    "dotenv": "~17.4.2",
    "express": "~5.3.0",
    "express-jwt": "~8.5.1",
    "jwks-rsa": "~4.1.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router-dom": "~7.18.5"
  },
  "devDependencies": {
    "@dossierhq/typescript-generator": "workspace:*",
    "@tailwindcss/vite": "~4.3.5",
    "@types/better-sqlite3": "~7.6.13",
    "@types/body-parser": "~1.19.6",
    "@types/express": "~5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "concurrently": "~10.0.7",
    "nodemon": "~3.1.14",
    "tailwindcss": "~4.3.5",
    "tailwindcss-animate": "~1.0.7",
    "typescript": "~6.0.3",
    "vite": "8.3.8"
  }
}
