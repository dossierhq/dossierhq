    "graphql": "~16.13.2",
    "graphql-voyager": "~2.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dossierhq/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "~4.3.0",
    "@types/better-sqlite3": "~7.6.13",
    "@types/react": "19.2.18",
    "eslint": "~10.8.0",
    "postcss": "~8.5.6",
    "tailwindcss": "~4.3.0",
    "tailwindcss-animate": "~1.0.7",
    "typescript": "~6.0.3"
